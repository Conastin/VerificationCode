{
  "manifest_version": 3,
  "name": "验证码自动识别填充",
  "version": "3.0.0",
  "description": "验证码自动识别填充：通用 CRNN 模型（变长验证码，任意站点），图片验证码本地识别，纯文字验证码 DOM 直读；页面内可视化点选配置，识别/提交失败自动收集样本可导出修正",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "downloads"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "验证码失败样本"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "vendor/onnxruntime-web/ort.wasm.min.js",
        "shared/recognizer.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "model.onnx",
        "vendor/onnxruntime-web/ort-wasm-simd-threaded.mjs",
        "vendor/onnxruntime-web/ort-wasm-simd-threaded.wasm"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
