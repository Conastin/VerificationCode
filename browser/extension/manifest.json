{
  "manifest_version": 3,
  "name": "验证码自动识别填充",
  "version": "2.2.7",
  "description": "右键图片标记为验证码，自动寻找验证码输入框并填充（浏览器本地识别，通用站点）；识别/提交失败自动收集样本可导出修正",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["contextMenus", "storage", "activeTab", "scripting", "downloads"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "验证码失败样本"
  },
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "vendor/onnxruntime-web/ort.wasm.min.js",
        "shared/recognizer.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "model.onnx",
        "vendor/onnxruntime-web/ort-wasm-simd-threaded.mjs",
        "vendor/onnxruntime-web/ort-wasm-simd-threaded.wasm"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
